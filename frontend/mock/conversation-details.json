    "audio_sec": 273.21,
    "segment": "hold",
    "recorded": true,
    "after_end": false,
    "event_type": null,
    "dup_of": null
   },
   {
    "mid": "m41",
    "idx": 41,
    "speaker": "operator",
    "text": "Ммм, всё хорошо тогда.",
