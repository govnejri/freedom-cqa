    "audio_sec": null,
    "segment": "bot",
    "recorded": true,
    "after_end": false,
    "event_type": null,
    "dup_of": null
   },
   {
    "mid": "m5",
    "idx": 5,
    "speaker": "client",
    "text": "Я сейчас с ноутбука, отчёт качать не хочу. Можно оператора?",
    "ts_raw": "00:28",
    "offset_sec": 28.0,
    "audio_sec": null,
    "segment": "bot",
    "recorded": true,
    "after_end": false,
    "event_type": null,
    "dup_of": null
   },
   {
    "mid": "m6",
    "idx": 6,
    "speaker": "bot",
