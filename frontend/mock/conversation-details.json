    "event_type": null,
    "dup_of": null
   },
   {
    "mid": "m40",
    "idx": 40,
    "speaker": "operator",
    "text": "Поэтому есть и такие бумаги, по которым стакан есть и кажется, как будто бы можно, но нет, значит, через очень.",
    "ts_raw": "2026-11-03T13:54:23.4423975+00:00",
