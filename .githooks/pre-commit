#!/bin/sh
# Блокирует коммит, если в индекс попала подписанная ссылка (sig=) или ключ API.
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -qE 'sig=[A-Za-z0-9%_-]{10,}|sk-ant-[A-Za-z0-9_-]{10,}'; then
  echo "pre-commit: в изменениях найден секрет (sig=... или ключ API). Коммит отменён." >&2
  exit 1
fi
for f in $(git diff --cached --name-only); do
  case "$f" in
    data/*|.env|*Student_Guide*.pdf) echo "pre-commit: файл $f не должен попасть в репозиторий." >&2; exit 1;;
  esac
done
